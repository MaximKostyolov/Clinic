<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://ktelabs.ru/" elementFormDefault="qualified">

    <xs:element name="ScheduleRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="workingDays" type="xs:string"/>
                <xs:element name="duration" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="ScheduleResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="recordingTimes" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>